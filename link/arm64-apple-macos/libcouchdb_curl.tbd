--- !tapi-tbd
tbd-version: 4
targets: [ arm64-macos, x86_64-macos ]
install-name: '/usr/lib/libcurl.4.dylib'
exports:
  - targets: [ arm64-macos, x86_64-macos ]
    symbols: [ _curl_easy_init, _curl_easy_cleanup, _curl_easy_setopt,
               _curl_easy_perform, _curl_easy_getinfo, _curl_easy_strerror,
               _curl_slist_append, _curl_slist_free_all,
               _curl_global_init ]
...
